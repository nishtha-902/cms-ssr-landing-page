# Get these values from your Sanity project.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Used only by the server. Keep this secret.
SANITY_REVALIDATE_SECRET=replace_with_a_long_random_secret

# Optional: used by the Sanity CLI.
SANITY_API_VERSION=2026-05-15